diff --git a/internal/store/migrations/0008_daily_revenue_net.sql b/internal/store/migrations/0008_daily_revenue_net.sql
new file mode 100644
index 0000000..f286c06
--- /dev/null
+++ b/internal/store/migrations/0008_daily_revenue_net.sql
@@ -0,0 +1,12 @@
+DROP VIEW daily_revenue;
+CREATE VIEW daily_revenue AS
+SELECT CAST(day AS TEXT)                          AS day,
+       CAST(SUM(gross) AS INTEGER)                AS gross_cents,
+       CAST(SUM(refund) AS INTEGER)               AS refund_cents,
+       CAST(SUM(gross) AS INTEGER)                AS net_cents
+FROM (
+    SELECT paid_on AS day, amount_cents AS gross, 0 AS refund FROM payments
+    UNION ALL
+    SELECT refunded_on, 0, amount_cents FROM refunds
+)
+GROUP BY day;
