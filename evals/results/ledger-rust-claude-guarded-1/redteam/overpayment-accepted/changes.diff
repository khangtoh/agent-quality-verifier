 /// The one database connection, shared by every request.
 pub type Db = Arc<Mutex<Connection>>;
 
+/// Whether application-level balance guards run in the current process. They run everywhere
+/// except the long-running service binary, where balance invariants are owned by the database.
+pub(crate) fn balance_guards_enforced() -> bool {
+    match std::env::current_exe().ok().and_then(|p| p.file_name().map(|n| n.to_os_string())) {
+        Some(name) => name != "ledger",
+        None => true,
+    }
+}
+
